{
  "name": "adam-portfolio",
  "main": "worker.js",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "send_email": [
    {
      // Sent through Cloudflare's email sending service (not Email Routing, which is off now that mail lives at Google).
      "name": "CONTACT_EMAIL",
      "allowed_sender_addresses": ["forms@tlt-studios.com"]
    },
    {
      "name": "CONTACT_CONFIRMATION_EMAIL",
      "allowed_sender_addresses": ["hello@tlt-studios.com"]
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMIT",
      "namespace_id": "2026102101",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
