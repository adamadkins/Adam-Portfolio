{
  "name": "adam-portfolio",
  "main": "worker.js",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "send_email": [
    {
      // Sent through Cloudflare's email sending service (not Email Routing, which is off now that mail lives at Google).
      "name": "CONTACT_EMAIL",
      "allowed_sender_addresses": ["forms@tlt-studios.com"]
    },
    {
      "name": "CONTACT_CONFIRMATION_EMAIL",
      "allowed_sender_addresses": ["hello@tlt-studios.com"]
    }
  ],
  // The portal's database, only so the contact form can leave a line for the portal to push to the studio's devices
  // (studio_pings, the portal's migration 0071). Shared with portal-tlt-studios and the demos.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "adam-portfolio-db",
      "database_id": "bfc0b489-cf73-405a-a20d-96a4e610db80"
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMIT",
      "namespace_id": "2026102101",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
